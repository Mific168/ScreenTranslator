<Window x:Class="ScreenTranslator.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Экранный переводчик"
        Width="500" MinWidth="480" SizeToContent="Height"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Заголовок (за него можно перетаскивать окно; двойной щелчок — обычный размер) ===== -->
            <DockPanel Grid.Row="0" Margin="12,0,5,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HistoryButton" Style="{StaticResource IconButton}" Content="&#xE81C;"
                            ToolTip="История переводов" WindowChrome.IsHitTestVisibleInChrome="True" Click="HistoryButton_Click"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;"
                            ToolTip="Настройки" WindowChrome.IsHitTestVisibleInChrome="True" Click="SettingsButton_Click"/>
                    <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggleButton}" Content="&#xE718;"
                                  ToolTip="Закрепить: не закрывать при клике вне окна"
                                  WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11"
                            ToolTip="Закрыть (Esc)" WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="AppIconImage" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="Экранный переводчик" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <!-- Пока высота окна подстраивается под содержимое, строка «*» ведёт себя как Auto.
                 Когда высоту задаёт пользователь, всё свободное место получает поле перевода. -->
            <Grid Grid.Row="1" Margin="14,0,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="TranslationRow" Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                <!-- ===== Распознанный текст ===== -->
                <Grid Margin="0,2,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Распознанный текст" Style="{StaticResource SectionHeader}"/>
                    <Button x:Name="SwapLanguagesButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8CB;"
                            Margin="0,0,4,0" Click="SwapLanguagesButton_Click"
                            ToolTip="Поменять местами язык текста и язык перевода (вместе с текстами)"/>
                    <ComboBox x:Name="SourceLangCombo" Grid.Column="2" Width="200"
                              DisplayMemberPath="Name" SelectedValuePath="Code"
                              ToolTip="Язык исходного текста" SelectionChanged="SourceLangCombo_SelectionChanged"/>
                </Grid>

                <Grid>
                    <TextBox x:Name="SourceBox" Style="{StaticResource MultilineBox}" MinHeight="70" MaxHeight="160"
                             Tag="Текст можно исправить перед переводом (Ctrl+Enter — перевести)"
                             PreviewKeyDown="SourceBox_PreviewKeyDown"/>
                    <Border x:Name="OcrBusyPanel" Background="{DynamicResource InputBrush}" CornerRadius="4" Margin="1"
                            Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Распознаю текст…" Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"/>
                            <ProgressBar IsIndeterminate="True" Width="180" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock x:Name="DetectInfoText" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>

                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="CopySourceButton" Style="{StaticResource ActionButton}" Click="CopySourceButton_Click"
                            ToolTip="Скопировать распознанный текст">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0"/>
                            <TextBlock Text="Копировать"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Tag="Google" Click="SourceWebButton_Click"
                            ToolTip="Открыть перевод в Google Переводчике">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0"/>
                            <TextBlock Text="Google"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Tag="Yandex" Click="SourceWebButton_Click"
                            ToolTip="Открыть перевод в Яндекс Переводчике">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0"/>
                            <TextBlock Text="Яндекс"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeepSeekButton" Style="{StaticResource ActionButton}" Click="DeepSeekButton_Click">
                        <Button.ToolTip>
                            <TextBlock MaxWidth="320" TextWrapping="Wrap">
                                Открыть DeepSeek в браузере и вставить туда картинку с текстом и просьбу перевести.<LineBreak/>
                                <Run FontWeight="SemiBold">Нужно быть авторизованным в DeepSeek</Run>
                                (войти в аккаунт на chat.deepseek.com в выбранном браузере).
                            </TextBlock>
                        </Button.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0"/>
                            <TextBlock Text="DeepSeek"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- Ошибка распознавания (нет текста, нет языкового пакета OCR) -->
                <Border x:Name="OcrErrorPanel" Style="{StaticResource ErrorPanel}" Margin="0,2,0,6" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="OcrErrorText" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="OcrHelpButton" Style="{StaticResource ActionButton}" Content="Как установить язык OCR"
                                    Click="OcrHelpButton_Click"/>
                            <Button x:Name="ReselectButton" Style="{StaticResource ActionButton}" Content="Выделить заново"
                                    Click="ReselectButton_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- ===== Перевод ===== -->
                <Grid x:Name="TranslationSection" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="TranslationBoxRow" Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,8,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Перевод" Style="{StaticResource SectionHeader}"/>
                        <ComboBox x:Name="ProviderCombo" Grid.Column="1" Width="186" Margin="0,0,6,0"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  ToolTip="Сервис перевода (выбор сохраняется в настройках)"
                                  SelectionChanged="ProviderCombo_SelectionChanged"/>
                        <ComboBox x:Name="TargetLangCombo" Grid.Column="2" Width="200"
                                  DisplayMemberPath="Name" SelectedValuePath="Code"
                                  ToolTip="Язык перевода" SelectionChanged="TargetLangCombo_SelectionChanged"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <TextBox x:Name="TranslationBox" Style="{StaticResource ResultBox}" MinHeight="70" MaxHeight="180"
                                 Tag="Здесь появится перевод"/>
                        <ProgressBar x:Name="TranslationProgress" IsIndeterminate="True" VerticalAlignment="Bottom"
                                     Margin="4,0,4,2" Visibility="Collapsed"/>
                    </Grid>

                    <Border x:Name="TranslationErrorPanel" Grid.Row="2" Style="{StaticResource ErrorPanel}" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="TranslationErrorText" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource AccentActionButton}" Content="Google Переводчик" Tag="Google"
                                        Click="SourceWebButton_Click"/>
                                <Button Style="{StaticResource AccentActionButton}" Content="Яндекс Переводчик" Tag="Yandex"
                                        Click="SourceWebButton_Click"/>
                                <Button x:Name="ErrorSettingsButton" Style="{StaticResource ActionButton}" Content="Настройки"
                                        Click="SettingsButton_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button x:Name="TranslateButton" Style="{StaticResource AccentActionButton}" Click="TranslateButton_Click"
                                ToolTip="Перевести (Ctrl+Enter в поле текста)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C1;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0"/>
                                <TextBlock Text="Перевести"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CopyTranslationButton" Style="{StaticResource ActionButton}" Click="CopyTranslationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0"/>
                                <TextBlock Text="Копировать перевод"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>

                <StackPanel Grid.Row="2">
                <Separator Margin="0,8,0,10"/>

                <!-- ===== Быстрый ответ ===== -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ваш ответ" Style="{StaticResource SectionHeader}"/>
                    <ComboBox x:Name="ReplyLangCombo" Grid.Column="1" Width="200"
                              DisplayMemberPath="Name" SelectedValuePath="Code"
                              ToolTip="На какой язык перевести ответ (по умолчанию — язык исходного текста)"
                              SelectionChanged="ReplyLangCombo_SelectionChanged"/>
                </Grid>

                <TextBox x:Name="ReplyBox" Style="{StaticResource MultilineBox}" MinHeight="54" MaxHeight="130"
                         Tag="Напишите ответ на родном языке и нажмите Enter (Shift+Enter — новая строка)"
                         PreviewKeyDown="ReplyBox_PreviewKeyDown"/>

                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="ReplyTranslateButton" Style="{StaticResource AccentActionButton}" Click="ReplyTranslateButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0"/>
                            <TextBlock Text="Перевести ответ"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Tag="Google" Click="ReplyWebButton_Click"
                            ToolTip="Открыть перевод ответа в Google Переводчике">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0"/>
                            <TextBlock Text="Google"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Tag="Yandex" Click="ReplyWebButton_Click"
                            ToolTip="Открыть перевод ответа в Яндекс Переводчике">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0"/>
                            <TextBlock Text="Яндекс"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <StackPanel x:Name="ReplyResultPanel" Visibility="Collapsed">
                    <Grid>
                        <TextBox x:Name="ReplyResultBox" Style="{StaticResource ResultBox}" MinHeight="54" MaxHeight="150"/>
                        <ProgressBar x:Name="ReplyProgress" IsIndeterminate="True" VerticalAlignment="Bottom"
                                     Margin="4,0,4,2" Visibility="Collapsed"/>
                    </Grid>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="CopyReplyButton" Style="{StaticResource AccentActionButton}" Click="CopyReplyButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" Margin="0,1,6,0"/>
                                <TextBlock Text="Копировать перевод ответа"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <Border x:Name="ReplyErrorPanel" Style="{StaticResource ErrorPanel}" Margin="0,2,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ReplyErrorText" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource AccentActionButton}" Content="Google Переводчик" Tag="Google"
                                    Click="ReplyWebButton_Click"/>
                            <Button Style="{StaticResource AccentActionButton}" Content="Яндекс Переводчик" Tag="Yandex"
                                    Click="ReplyWebButton_Click"/>
                            <Button Style="{StaticResource ActionButton}" Content="Настройки" Click="SettingsButton_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" Foreground="{DynamicResource SuccessBrush}"
                           Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
