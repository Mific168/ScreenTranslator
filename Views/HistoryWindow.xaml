<Window x:Class="ScreenTranslator.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История переводов — Экранный переводчик"
        Width="640" Height="620" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="История переводов" Style="{StaticResource PageTitle}"/>

        <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,12,0,10"
                 Tag="Поиск по исходному тексту и переводу…" TextChanged="SearchBox_TextChanged"/>

        <Grid Grid.Row="2">
            <ListBox x:Name="EntriesList" SelectionMode="Single"
                     MouseDoubleClick="EntriesList_MouseDoubleClick" SelectionChanged="EntriesList_SelectionChanged"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="{Binding KindGlyph}" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,2,6,0"/>
                                <TextBlock Text="{Binding KindText}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DateText}" FontSize="12" Margin="10,0,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding LangsText}" FontSize="12" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="{Binding SourcePreview}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="2" Text="{Binding TranslationPreview}" Margin="0,2,0,0"
                                       TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="20"
                       Visibility="Collapsed"/>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="OpenButton" DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Content="Открыть"
                    ToolTip="Загрузить запись в окно перевода (двойной щелчок)" Click="OpenButton_Click" Margin="0,0,6,0"/>
            <Button x:Name="CopySourceButton" DockPanel.Dock="Left" Content="Копировать исходный текст"
                    Click="CopySourceButton_Click" Margin="0,0,6,0"/>
            <Button x:Name="CopyTranslationButton" DockPanel.Dock="Left" Content="Копировать перевод"
                    Click="CopyTranslationButton_Click"/>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource SuccessBrush}" FontSize="12"/>
        </DockPanel>
    </Grid>
</Window>
