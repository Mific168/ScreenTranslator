<Window x:Class="ScreenTranslator.Views.SelectionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выделение области"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Background="Black" Cursor="Cross"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">
    <Grid x:Name="Root" ClipToBounds="True">
        <!-- «Замороженный» снимок экрана: выделение не мешает видео, подсказкам и т.п. -->
        <Image x:Name="ScreenImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

        <!-- Затемнение с «окном» в месте выделения -->
        <Path x:Name="Shade" Fill="#8C000000" IsHitTestVisible="False"/>

        <Rectangle x:Name="SelectionBorder" Stroke="#4CC2FF" StrokeThickness="1.5"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"/>

        <Border x:Name="SizeLabel" Background="#E6202020" CornerRadius="4" Padding="6,2"
                HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="12"/>
        </Border>

        <Border x:Name="Hint" Background="#E6202020" CornerRadius="8" Padding="16,10"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" IsHitTestVisible="False">
            <TextBlock x:Name="HintText" Foreground="White" FontSize="14"
                       Text="Выделите мышью область с текстом  ·  Esc или правая кнопка — отмена"/>
        </Border>
    </Grid>
</Window>
